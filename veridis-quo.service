[Unit]
Description=Veridis Quo Flask Application
After=network.target

[Service]
User=ec2-user
WorkingDirectory=/home/ec2-user/veridis-quo
Environment="PATH=/home/ec2-user/veridis-quo/venv/bin"
ExecStart=/home/ec2-user/veridis-quo/venv/bin/gunicorn --workers 3 --bind 0.0.0.0:5000 wsgi:app
Restart=always

[Install]
WantedBy=multi-user.target 